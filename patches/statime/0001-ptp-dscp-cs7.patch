+impl<A: NetworkAddress, S> Socket<A, S> {
+    /// Marks packets sent from this (IPv4) socket with a DSCP value.
+    pub fn set_dscp(&self, dscp: u8) -> std::io::Result<()> {
+        let tos: libc::c_int = (dscp as libc::c_int) << 2;
+        // Safety: tos lives for the duration of the call and we pass its size
+        crate::cerr(unsafe {
+            libc::setsockopt(
+                self.socket.get_ref().as_raw_fd(),
+                libc::IPPROTO_IP,
+                libc::IP_TOS,
+                &tos as *const _ as *const libc::c_void,
+                std::mem::size_of_val(&tos) as libc::socklen_t,
+            )
+        })?;
+        Ok(())
+    }
+}
