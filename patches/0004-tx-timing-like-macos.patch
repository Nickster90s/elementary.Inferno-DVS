+// How the TX thread waits for a packet deadline (same scheme as the macOS engine). With
+// TX_WAKE_EARLY_NS = 0 it sleeps until the deadline. Otherwise it sleeps until that much before
+// it, then waits on the media clock: short sleeps while more than TX_SPIN_NS remain, then spins.
+// A late wake-up (idle CPU, interrupts held off) then costs spin time instead of a late packet.
+static TX_WAKE_EARLY_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static TX_SPIN_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(50_000);
+
+pub fn set_tx_wake_early_ns(ns: u64) {
+  TX_WAKE_EARLY_NS.store(ns.min(2_000_000), Ordering::Relaxed);
+}
+
+pub fn set_tx_spin_ns(ns: u64) {
+  TX_SPIN_NS.store(ns.min(2_000_000), Ordering::Relaxed);
+}
+
