+  /// Sleeps until the media clock reaches deadline_ns (see TX_WAKE_EARLY_NS).
+  fn wait_for_deadline(&self, sleep_duration: Duration, deadline_ns: Option<u64>) {
+    let early = Duration::from_nanos(TX_WAKE_EARLY_NS.load(Ordering::Relaxed));
+    let (Some(deadline), false) = (deadline_ns, early.is_zero()) else {
+      std::thread::sleep(sleep_duration);
+      return;
+    };
+    let first = sleep_duration.saturating_sub(early);
+    if !first.is_zero() {
+      std::thread::sleep(first);
+    }
+    let spin_ns = TX_SPIN_NS.load(Ordering::Relaxed) as i64;
+    loop {
+      let Some(now) = self.clock.now_ns() else { return };
+      let remaining = deadline.wrapping_sub(now as u64) as i64;
+      if remaining <= 0 {
+        return;
+      }
+      if remaining > spin_ns {
+        // short steps: one long sleep here could overshoot past the deadline
+        std::thread::sleep(Duration::from_nanos(((remaining - spin_ns) as u64).min(50_000)));
+      } else {
+        std::hint::spin_loop();
+      }
+    }
+  }
