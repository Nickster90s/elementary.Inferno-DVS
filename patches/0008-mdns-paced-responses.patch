 pub use handle::BroadcasterHandle;
 use handle::*;
 
+/// Largest response we build. Stays under a 1500-byte MTU with the IP and UDP
+/// headers, so no mDNS response is ever fragmented.
+const MAX_PACKET: usize = 1400;
+
+/// Gap between the packets of one multi-packet response. A 1400-byte packet
+/// takes 0.11 ms on a 100 Mbit link, so at 1 ms apart a slow port never builds
+/// a queue in front of the audio sharing it.
+const PACKET_SPACING: std::time::Duration = std::time::Duration::from_millis(1);
+
+/// Merges per-service responses into as few packets as fit [`MAX_PACKET`],
+/// dropping records already present (every channel service carries the same
+/// host address record).
+fn pack_responses<'a>(responses: impl Iterator<Item = &'a DnsMessage>) -> Vec<Vec<u8>> {
+	fn new_message(template: &DnsMessage) -> DnsMessage {
+		let mut message = DnsMessage::new();
+		message.set_header(*template.header());
+		message
+	}
+	fn encode(message: &DnsMessage) -> Option<Vec<u8>> {
+		// emit() writes the header counts from the record lists itself.
+		let mut buf = Vec::with_capacity(MAX_PACKET);
+		message.emit(&mut BinEncoder::new(&mut buf)).ok().map(|_| buf)
+	}
+
+	let mut packets = Vec::new();
+	let mut current: Option<DnsMessage> = None;
+	for response in responses {
+		let mut candidate = current.clone().unwrap_or_else(|| new_message(response));
+		let before = (candidate.answers().len(), candidate.additionals().len());
+		for record in response.answers() {
+			if !candidate.answers().contains(record) {
+				candidate.answers_mut().push(record.clone());
+			}
+		}
+		for record in response.additionals() {
+			if !candidate.answers().contains(record) && !candidate.additionals().contains(record) {
+				candidate.additionals_mut().push(record.clone());
+			}
+		}
+		if (candidate.answers().len(), candidate.additionals().len()) == before {
+			continue; // nothing new
+		}
+		match encode(&mut candidate) {
+			Some(buf) if buf.len() <= MAX_PACKET => current = Some(candidate),
+			_ => {
+				// Full: send what we have and start a new packet with this service.
+				if let Some(mut full) = current.take() {
+					packets.extend(encode(&mut full));
+				}
+				let mut fresh = new_message(response);
+				*fresh.answers_mut() = response.answers().to_vec();
+				*fresh.additionals_mut() = response.additionals().to_vec();
+				current = Some(fresh);
+			}
+		}
+	}
+	if let Some(mut last) = current {
+		packets.extend(encode(&mut last));
+	}
+	packets
+}
