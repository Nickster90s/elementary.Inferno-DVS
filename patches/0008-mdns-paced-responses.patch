+#[cfg(test)]
+mod pack_tests {
+	use super::*;
+	use std::net::{IpAddr, Ipv4Addr};
+	use trust_dns_client::rr::Name as DnsName;
+
+	fn channel_responses(n: usize) -> Vec<DnsMessage> {
+		(1..=n)
+			.map(|i| {
+				// Built the way inferno's mdns_server.rs builds a channel service.
+				let ty = DnsName::from_labels(["_netaudio-chan", "_udp", "local"]).unwrap();
+				let name = DnsName::from_labels([format!("TX {i}@N-Series-AoIP-1584").as_bytes()]).unwrap();
+				ServiceBuilder::new(ty, name, 4455)
+					.unwrap()
+					.hostname(DnsName::from_labels(["N-Series-AoIP-1584"]).unwrap())
+					.unwrap()
+					.add_ip_address(IpAddr::V4(Ipv4Addr::new(169, 254, 231, 218)))
+					.add_txt_truncated("txtvers=2")
+					.add_txt_truncated(format!("id={i}"))
+					.add_txt_truncated("rate=96000")
+					.add_txt_truncated("latency_ns=1000000")
+					.add_txt_truncated("fpp=32,32")
+					.build()
+					.unwrap()
+					.dns_response()
+					.unwrap()
+			})
+			.collect()
+	}
+
+	#[test]
+	fn sixty_four_channels_pack_into_few_packets_without_losing_records() {
+		let responses = channel_responses(64);
+		let packets = pack_responses(responses.iter());
+
+		let single: usize = responses.iter().map(|r| r.to_vec().unwrap().len()).sum();
+		let packed: usize = packets.iter().map(Vec::len).sum();
+		println!("{} packets, {packed} B (was {} packets, {single} B)", packets.len(), responses.len());
+
+		assert!(packets.len() < responses.len() / 4);
+		assert!(packets.iter().all(|p| p.len() <= MAX_PACKET));
+
+		// Every record of every service arrives, and the shared host address once per packet.
+		let mut got = Vec::new();
+		for p in &packets {
+			let m = DnsMessage::from_bytes(p).unwrap();
+			let a = m.answers().iter().chain(m.additionals()).filter(|r| r.rr_type() == trust_dns_client::rr::RecordType::A).count();
+			assert_eq!(a, 1);
+			got.extend(m.answers().iter().chain(m.additionals()).cloned());
+		}
+		for r in &responses {
+			for rec in r.answers().iter().chain(r.additionals()) {
+				assert!(got.contains(rec), "missing {rec:?}");
 			}
 		}
 	}
+
+	#[test]
+	fn one_service_is_one_packet_as_before() {
+		let responses = channel_responses(1);
+		let packets = pack_responses(responses.iter());
+		assert_eq!(packets.len(), 1);
+		let m = DnsMessage::from_bytes(&packets[0]).unwrap();
+		assert_eq!(m.answers(), responses[0].answers());
+		assert_eq!(m.additionals(), responses[0].additionals());
+	}
 }
