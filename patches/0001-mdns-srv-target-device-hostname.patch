+	/// Sets the host name (without `.local`) the SRV target and address
+	/// records use. Defaults to the service name, which is only right when the
+	/// service name is also a valid host name. Services such as Dante channels
+	/// (`<channel>@<device>`) must point at the device's host name instead.
+	pub fn hostname(mut self, host: impl IntoDnsName) -> Result<Self, BadDnsNameError> {
+		let local = DnsName::from_labels(["local"]).unwrap();
+		let host = host.into_name().map_err(|_| BadDnsNameError)?;
+		self.0.service_hostname = host.append_domain(&local).map_err(|_| BadDnsNameError)?;
