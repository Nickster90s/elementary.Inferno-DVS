TX thread above RX thread; optional CPU pinning (TX_CPU / RX_CPU)

rtkit capped both flows threads at its maximum priority, so on a shared CPU
the TX thread waited for the RX thread: with an RX flow active, thousands of
TX packets per 10 s left 200-700 us late. RX now runs one level below TX,
and each thread can be pinned to its own CPU.

--- a/inferno_aoip/src/util/os.rs
+++ b/inferno_aoip/src/util/os.rs
@@ -41,6 +41,30 @@
   direct
 }
 
+/// CPUs for the flows threads (-1: let the scheduler choose). Set with TX_CPU / RX_CPU.
+pub static TX_CPU: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(-1);
+pub static RX_CPU: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(-1);
+
+/// Pins the current thread to one CPU. The TX and RX threads run at nearly the same realtime
+/// priority; on a shared CPU one waits for the other, which showed up as TX packets sent
+/// 200-700 us late whenever an RX flow was active.
+pub fn pin_current_thread(cpu: &std::sync::atomic::AtomicI32) {
+  let cpu = cpu.load(std::sync::atomic::Ordering::Relaxed);
+  if cpu < 0 {
+    return;
+  }
+  #[cfg(target_os = "linux")]
+  unsafe {
+    let mut set: libc::cpu_set_t = std::mem::zeroed();
+    libc::CPU_SET(cpu as usize, &mut set);
+    if libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &set) == 0 {
+      log::info!("thread {} pinned to CPU {cpu}", thread_name());
+    } else {
+      log::warn!("thread {} not pinned to CPU {cpu}: {}", thread_name(), std::io::Error::last_os_error());
+    }
+  }
+}
+
 fn thread_name() -> String {
   std::thread::current().name().unwrap_or("?").to_owned()
 }
