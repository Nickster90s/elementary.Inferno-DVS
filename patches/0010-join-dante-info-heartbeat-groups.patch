@@ -556,6 +556,18 @@ pub async fn run_server(
 ) {
   let server =
     UdpSocketWrapper::new(Some(self_info.ip_address), self_info.info_request_port, shutdown).await;
+  // Dante devices join the groups they announce on, and 239.255.255.255, the
+  // group Luminex Araneo's IGMP tab files a device under "Dante" by. Switches
+  // flood 224.0.0.x anyway; 239.255.255.255 carried ~8 kbit/s on the bench.
+  for group in [
+    Ipv4Addr::new(224, 0, 0, 231),
+    Ipv4Addr::new(224, 0, 0, 233),
+    Ipv4Addr::new(239, 255, 255, 255),
+  ] {
+    if let Err(e) = server.join_multicast_v4(group, self_info.ip_address) {
+      warn!("cannot join {group}: {e}");
+    }
+  }
   let mut recv_buff = crate::net_utils::ReceiveBuffer::new();
   let mut mcaster = Multicaster::new(self_info.as_ref(), server, clock, get_peaks);
   mcaster.send_board_info().await;
