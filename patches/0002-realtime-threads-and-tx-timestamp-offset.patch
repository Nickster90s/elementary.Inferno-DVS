+}
+
+fn thread_name() -> String {
+  std::thread::current().name().unwrap_or("?").to_owned()
+}
+
+/// Non-realtime threads get 50 us of timer slack by default; use the minimum
+/// so sleeps end on time even if realtime scheduling is unavailable.
+#[cfg(target_os = "linux")]
+fn set_timer_slack_min() {
+  unsafe {
+    libc::prctl(libc::PR_SET_TIMERSLACK, 1 as libc::c_ulong, 0, 0, 0);
+  }
+}
+
+#[cfg(target_os = "linux")]
+mod rtkit {
+  use std::process::Command;
+
+  const DEST: &str = "org.freedesktop.RealtimeKit1";
+  const PATH: &str = "/org/freedesktop/RealtimeKit1";
+
+  fn busctl(args: &[&str]) -> Result<String, String> {
+    let out = Command::new("busctl")
+      .arg("--system")
+      .args(args)
+      .output()
+      .map_err(|e| format!("busctl: {e}"))?;
+    if out.status.success() {
+      Ok(String::from_utf8_lossy(&out.stdout).trim().to_owned())
+    } else {
+      Err(String::from_utf8_lossy(&out.stderr).trim().to_owned())
+    }
+  }
+
+  /// rtkit refuses processes without an RLIMIT_RTTIME. PipeWire sets one
+  /// (200 ms); set the same for other hosts (aplay, JACK clients, ...).
+  fn ensure_rttime_limit() {
+    unsafe {
+      let mut lim = std::mem::zeroed::<libc::rlimit>();
+      if libc::getrlimit(libc::RLIMIT_RTTIME, &mut lim) == 0 && lim.rlim_max == libc::RLIM_INFINITY {
+        let l = libc::rlimit { rlim_cur: 200_000, rlim_max: 200_000 };
+        libc::setrlimit(libc::RLIMIT_RTTIME, &l);
+      }
+    }
+  }
+
+  pub fn make_current_thread_realtime(hint: u32) -> Result<u32, String> {
+    ensure_rttime_limit();
+    let max = busctl(&["get-property", DEST, PATH, DEST, "MaxRealtimePriority"])
+      .ok()
+      .and_then(|s| s.split_whitespace().nth(1).and_then(|v| v.parse::<u32>().ok()))
+      .unwrap_or(20);
+    let prio = hint.min(max).max(1);
+    let pid = std::process::id().to_string();
+    let tid = unsafe { libc::gettid() }.to_string();
+    let prio_s = prio.to_string();
+    busctl(&["call", DEST, PATH, DEST, "MakeThreadRealtimeWithPID", "ttu", &pid, &tid, &prio_s])?;
+    Ok(prio)
+  }
 }
 
