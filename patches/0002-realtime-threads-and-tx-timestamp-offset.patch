+/// Make the current thread realtime (SCHED_FIFO/RR).
+///
+/// Tries `sched_setscheduler` first. That fails for ordinary desktop users
+/// (RLIMIT_RTPRIO is 0), which is how PipeWire runs, so it then asks
+/// RealtimeKit over D-Bus, the same way PipeWire's own module-rt gets its
+/// data thread realtime. The priority is clamped to rtkit's maximum.
 #[cfg(target_family = "unix")]
 pub fn set_current_thread_realtime(priority_hint: u8) -> Result<(), Error> {
   use thread_priority::unix::set_thread_priority_and_policy;
@@ -7,11 +13,92 @@ pub fn set_current_thread_realtime(priority_hint: u8) -> Result<(), Error> {
     RealtimeThreadSchedulePolicy, ThreadPriority, ThreadPriorityValue, ThreadSchedulePolicy,
   };
 
-  set_thread_priority_and_policy(
+  let direct = set_thread_priority_and_policy(
     thread_native_id(),
     ThreadPriority::Crossplatform(ThreadPriorityValue::try_from(priority_hint).unwrap()),
     ThreadSchedulePolicy::Realtime(RealtimeThreadSchedulePolicy::Fifo),
-  )
+  );
+  if direct.is_ok() {
+    log::info!("thread {} realtime (priority {priority_hint}, direct)", thread_name());
+    return direct;
+  }
+  #[cfg(target_os = "linux")]
+  {
+    set_timer_slack_min();
+    match rtkit::make_current_thread_realtime(priority_hint as u32) {
+      Ok(prio) => {
+        log::info!("thread {} realtime (priority {prio}, via rtkit)", thread_name());
+        return Ok(());
+      }
+      Err(e) => {
+        log::warn!(
+          "thread {} could not be made realtime ({direct:?}; rtkit: {e}); expect timing jitter",
+          thread_name()
+        );
+      }
+    }
