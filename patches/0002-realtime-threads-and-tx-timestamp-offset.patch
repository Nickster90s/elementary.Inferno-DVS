+
+/// Lag statistics on the media clock: for TX how late each packet actually left,
+/// for RX how late (relative to its timestamp) each packet arrived.
+pub(super) struct LagStats {
+  buckets: [u64; 7], // <25, <50, <100, <200, <500, <1000, >=1000 us
+  max_ns: i64,
+  sum_ns: i64,
+  count: u64,
+  next_report: std::time::Instant,
+}
+
+impl LagStats {
+  const EDGES_US: [i64; 6] = [25, 50, 100, 200, 500, 1000];
+  pub(super) fn new() -> Self {
+    Self {
+      buckets: [0; 7],
+      max_ns: 0,
+      sum_ns: 0,
+      count: 0,
+      next_report: std::time::Instant::now() + Duration::from_secs(10),
+    }
+  }
+  #[inline(always)]
+  pub(super) fn record(&mut self, lag_ns: i64) {
+    let us = lag_ns / 1000;
+    let i = Self::EDGES_US.iter().position(|&e| us < e).unwrap_or(6);
+    self.buckets[i] += 1;
+    self.max_ns = self.max_ns.max(lag_ns);
+    self.sum_ns += lag_ns;
+    self.count += 1;
+  }
+  fn maybe_report(&mut self, offset_ns: i64) {
+    self.maybe_report_as("tx send lag", &format!("ts offset {} us", offset_ns / 1000));
+  }
+  pub(super) fn maybe_report_as(&mut self, what: &str, extra: &str) {
+    if self.count == 0 || std::time::Instant::now() < self.next_report {
+      return;
+    }
+    let b = &self.buckets;
+    info!(
+      "{what} over {} packets: avg {} us, max {} us | <25us {} <50 {} <100 {} <200 {} <500 {} <1000 {} >=1ms {} | {extra}",
+      self.count,
+      self.sum_ns / self.count as i64 / 1000,
+      self.max_ns / 1000,
+      b[0], b[1], b[2], b[3], b[4], b[5], b[6],
+    );
+    *self = Self::new();
+  }
+}
 
