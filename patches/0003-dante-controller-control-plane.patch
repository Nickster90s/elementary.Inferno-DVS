+/// Statime's observation socket, for sync quality in the heartbeat.
+pub fn set_ptp_observation_path(path: std::path::PathBuf) {
+  let _ = PTP_OBSERVATION_PATH.set(path);
+}
+
+/// (|offset from leader| ns, mean path delay ns) from Statime's observation
+/// socket. Durations there are I96F32 fixed point, serialised as integers.
+fn read_ptp_quality() -> Option<(u64, u64)> {
+  use std::io::Read;
+  let path = PTP_OBSERVATION_PATH.get()?;
+  let mut sock = std::os::unix::net::UnixStream::connect(path).ok()?;
+  sock.set_read_timeout(Some(Duration::from_millis(100))).ok()?;
+  let mut json = String::new();
+  sock.read_to_string(&mut json).ok()?;
+  let field = |name: &str| -> Option<f64> {
+    let at = json.find(&format!("\"{name}\":"))? + name.len() + 3;
+    let rest = json[at..].trim_start();
+    let end = rest.find(|c: char| !(c.is_ascii_digit() || c == '-')).unwrap_or(rest.len());
+    rest[..end].parse::<f64>().ok()
+  };
+  let scale = 4_294_967_296.0; // 2^32
+  let off = field("offset_from_master")? / scale;
+  let delay = field("mean_delay")? / scale;
+  Some((off.abs().round() as u64, delay.max(0.0).round() as u64))
+}
