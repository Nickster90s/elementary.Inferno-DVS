+/// Write a u32 into the 0x1100 data blob, at the offset an offset-key holds.
+fn arc_1100_patch_u32(table: &mut [u8], key: u16, value: u32) {
+  let count = table[1] as usize;
+  for i in 0..count {
+    let at = 2 + i * 4;
+    if make_u16(table[at], table[at + 1]) != key {
+      continue;
+    }
+    let off = make_u16(table[at + 2], table[at + 3]) as usize;
+    if off < HEADER_LENGTH || off - HEADER_LENGTH + 4 > table.len() {
+      return;
+    }
+    let bi = off - HEADER_LENGTH;
+    table[bi..bi + 4].copy_from_slice(&value.to_be_bytes());
+    return;
+  }
+}
+
+/// Dotted version string ("4.0.2", "2.7.41") to the u16 real devices put in
+/// their 0x1003 reply: high byte = major<<4 | minor for arcp-style, or
+/// major/minor bytes for router-style.
+fn version_word(v: &str, nibbles: bool) -> u16 {
+  let p: Vec<u16> = v.split('.').map(|x| x.parse().unwrap_or(0)).collect();
+  let (a, b, c) = (p.first().copied().unwrap_or(0), p.get(1).copied().unwrap_or(0), p.get(2).copied().unwrap_or(0));
+  if nibbles {
+    ((a & 0xf) << 12) | ((b & 0xf) << 8) | (c & 0xff)
+  } else {
+    ((a & 0xff) << 8) | (b & 0xff)
+  }
+}
